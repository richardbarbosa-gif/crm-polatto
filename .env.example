# CRM Polatto — variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase
# (Painel Supabase > Settings > API)

# URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Chave anônima (anon/public key) do Supabase.
# NUNCA usar a service_role key no frontend.
VITE_SUPABASE_KEY=
